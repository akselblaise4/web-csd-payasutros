{
  "rewrites": [
    { "source": "/api/standings/:groupId", "destination": "/api/standings" },
    { "source": "/api/match-days/:stageId", "destination": "/api/match-days" },
    { "source": "/api/groups/:stageId", "destination": "/api/groups" },
    { "source": "/api/tournaments/:leagueId", "destination": "/api/tournaments" },
    { "source": "/api/leagues", "destination": "/api/leagues" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET" }
      ]
    }
  ]
}
